<?xml version="1.0" encoding="utf-8"?>
<!-- Apple Music icon: official red gradient squircle + the note glyph -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="7.5dip" />
            <gradient android:startColor="#fffb5c74" android:endColor="#fffa233b" android:angle="270.0" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_home_apple_music_glyph" />
</layer-list>
